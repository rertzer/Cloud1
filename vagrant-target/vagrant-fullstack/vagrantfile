Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
  end

  # Ansible Server
  config.vm.define "ansible" do |ansible|
    ansible.vm.hostname = "ansible"
    ansible.vm.network "private_network", ip: "192.168.56.110"
	ansible.vm.provision "file", source: "01-netcfg.yaml", destination: "01-netcfg.yaml"
	ansible.vm.provision "shell", path: "ubuntu_server_install.sh"
    ansible.vm.provision "shell", path: "ansible_server_install.sh" 
	ansible.vm.provision "file", source: "../playdoh", destination: "/home/vagrant/playdoh"
	ansible.vm.provision "file", source: "cloud_ed25519", destination: "/home/vagrant/.ssh/cloud_ed25519"
	ansible.vm.provision "file", source: "ansible.cfg", destination: "/home/vagrant/ansible.cfg"
	ansible.vm.provision "shell", inline: "chmod 600 /home/vagrant/.ssh/cloud_ed25519"
  end

  # Server Worker
  #config.vm.define "worker" do |worker|
  # worker.vm.hostname = "worker"
  # worker.vm.network "private_network", ip: "192.168.56.111"
  # worker.vm.provision "file", source: "ubuntu_server_install.sh", destination: "/home/vagrant/ubuntu_server_install.sh" 
  # worker.vm.provision "shell", inline: "chmod 755 /home/vagrant/ubuntu_server_install.sh"
  # worker.vm.provision "file", source: "cloud_ed25519.pub", destination:"/home/vagrant/.ssh/cloud_ed25519.pub"
  # worker.vm.provision "shell", inline: "cat /home/vagrant/.ssh/cloud_ed25519.pub >> /home/vagrant/.ssh/authorized_keys"
 #end
end
